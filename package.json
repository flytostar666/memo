{
  "name": "shiguang-memo",
  "version": "1.0.1",
  "description": "一个无需联网、只在本机保存的 Windows 备忘录。",
  "main": "main.js",
  "author": "flytostar666",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/generate-icon.js",
    "pack": "npm run icon && electron-builder --dir --win",
    "dist:win": "npm run icon && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.flytostar.memo",
    "productName": "拾光备忘录",
    "copyright": "Copyright © 2026 flytostar666",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "app.js",
      "index.html",
      "main.js",
      "package.json",
      "styles.css"
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "拾光备忘录",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Shiguang-Memo-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Shiguang-Memo-Portable-${version}.${ext}"
    }
  }
}
